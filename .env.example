# Spendly reads environment variables. Export these in your shell (or add them to
# Streamlit secrets when hosting). A .env file is NOT loaded automatically.

# --- Optional AI (off by default; Spendly works fully without it) ---
SPENDLY_ENABLE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Limits ---
SPENDLY_MAX_UPLOAD_MB=10
SPENDLY_MAX_PDF_PAGES=60

# --- Storage ---
# Where the SQLite files live (default: ./data)
# SPENDLY_DATA_DIR=/path/to/folder

# Set to true on a shared/public host (e.g. Streamlit Community Cloud):
# each visitor gets private in-memory databases that vanish with the session.
SPENDLY_PUBLIC_DEPLOYMENT=false
