# Spendly reads environment variables. Export these in your shell (or add them to
# Streamlit secrets when hosting). A .env file is NOT loaded automatically.

# --- Optional AI (off by default; Spendly works fully without it) ---
SPENDLY_ENABLE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Limits ---
SPENDLY_MAX_UPLOAD_MB=10
SPENDLY_MAX_PDF_PAGES=60

# --- Storage ---
# Where the SQLite files live (default: ./data)
# SPENDLY_DATA_DIR=/path/to/folder

# Set to true on a shared/public host (e.g. Streamlit Community Cloud):
# each visitor gets private in-memory databases that vanish with the session.
SPENDLY_PUBLIC_DEPLOYMENT=false

# --- Security (see docs/SECURITY.md) ---
# Local (single-user) mode only accepts requests from this computer. Leave false.
SPENDLY_ALLOW_REMOTE=false
# Rate limits are always on in public mode; set true to also use them locally.
SPENDLY_RATE_LIMIT=false
# Only behind a reverse proxy you control: take the client IP from X-Forwarded-For.
SPENDLY_TRUST_PROXY=false
# Comma-separated web origins allowed to call the API directly (the Next.js proxy is same-origin).
# SPENDLY_CORS_ORIGINS=https://your-site.example
