  "_comment": "Spendly categorization rules. Merchants are checked top to bottom, so put more specific patterns (e.g. SWIGGY INSTAMART) before general ones (SWIGGY). Patterns are case-insensitive regular expressions matched against the cleaned description.",

  "type_rules": [
    {"name": "internal_transfer", "pattern": "\\b(SELF TRANSFER|TRANSFER TO SELF|TO SELF|OWN (A/?C|ACCOUNT)|SWEEP (IN|OUT)|FD (BOOKING|CREATION|PREMAT))\\b", "transaction_type": "transfer", "category": "Transfers", "merchant": "Own account transfer"},
