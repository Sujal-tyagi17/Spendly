    {"name": "salary", "pattern": "\\b(SALARY|SAL CREDIT|SAL FOR|PAYROLL|STIPEND)\\b", "direction": "credit", "transaction_type": "income", "category": "Income"},
    {"name": "interest_dividend", "pattern": "\\b(INTEREST (CREDIT|PAID)|INT\\.? ?PD|SB INT|DIVIDEND)\\b", "direction": "credit", "transaction_type": "income", "category": "Income", "merchant": "Interest / dividend"},
    {"name": "rent", "pattern": "\\b(HOUSE RENT|RENT FOR|RENT PAYMENT|RENT)\\b", "direction": "debit", "transaction_type": "expense", "category": "Rent & Housing"},
    {"name": "atm_cash", "pattern": "\\b(ATM (WDL|WITHDRAWAL|CASH)|CASH WITHDRAWAL|NWD)\\b", "direction": "debit", "transaction_type": "expense", "category": "Other", "merchant": "ATM cash withdrawal"},
    {"name": "electricity", "pattern": "\\b(ELECTRICITY|BESCOM|MSEDCL|TATA POWER|ADANI ELECTRICITY|BSES|TNEB|KSEB)\\b", "direction": "debit", "transaction_type": "expense", "category": "Bills & Utilities"},
