# Public URL of the running Streamlit app. The "Explore Spendly" buttons open it.
# Inlined into the browser bundle at BUILD time — never put secrets in NEXT_PUBLIC_ variables.
# Default when unset: http://localhost:8501 (Streamlit's local port)
NEXT_PUBLIC_APP_URL=http://localhost:8501

# Public URL of this marketing site, used for absolute Open Graph image links.
# Default when unset: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
