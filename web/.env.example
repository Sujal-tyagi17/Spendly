# Copy to .env.local for local overrides.

# Where Next.js forwards /api/* (the FastAPI backend). Server-side only — never sent to the browser.
SPENDLY_API_URL=http://127.0.0.1:8000

# Target of the "Explore Spendly" buttons. Default: the built-in app at /app.
# NEXT_PUBLIC_ values are inlined into the browser bundle at BUILD time — public URLs only, never secrets.
NEXT_PUBLIC_APP_URL=/app

# Public URL of this site, used for absolute Open Graph image links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
